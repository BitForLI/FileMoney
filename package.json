{
  "name": "pagefold",
  "version": "0.1.4",
  "private": true,
  "description": "Pagefold: a lightweight Markdown desktop app",
  "author": "Pagefold",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "icon": "node scripts/generate-icon.mjs",
    "dist:win": "npm run icon && npm run build && electron-builder --win nsis --x64 --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "sharp": "^0.34.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "com.pagefold.desktop",
    "productName": "Pagefold",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Pagefold",
      "artifactName": "Pagefold-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
